# ==============================================================================
# GOLD TITAN — Environment Configuration Template
# Copy to .env and populate ONLY public client variables here.
# NEVER place service-role keys, payment secret keys, or webhook secrets in VITE_* variables.
# ==============================================================================

# 1. Authoritative Launch-Slot Counter (Supabase public client read-only connection)
# Leave empty until the database migration in supabase/migrations/001_launch_allocation.sql
# has been deployed and connected to verified payment webhooks.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Subscription Checkout Endpoint (Server-side session creator)
# Only set VITE_CHECKOUT_ENABLED=true after:
#   a) Payment provider & settlement currency (USD / NGN) are confirmed
#   b) Discount stacking rule (30% first-five + 20% multi-month) is confirmed by the owner
#   c) Extra-month subscription extension offer terms are published
VITE_CHECKOUT_ENABLED=false
VITE_CHECKOUT_SESSION_ENDPOINT=
VITE_OFFER_TERMS_URL=
